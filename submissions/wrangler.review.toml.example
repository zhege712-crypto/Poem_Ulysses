name = "poem-submissions-review"
keep_names = false # Shared browser functions must remain self-contained when serialized.
main = "review.mjs"
compatibility_date = "2026-09-01"

[vars]
REVIEW_AUTH = "github"
REVIEWER_EMAILS = "zhege712@gmail.com"
GITHUB_OAUTH_CLIENT_ID = "REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID"
GITHUB_OWNER = "zhege712-crypto"
GITHUB_REPO = "Poem_Ulysses"
PUBLIC_SITE_URL = "https://zhege712-crypto.github.io/Poem_Ulysses/"
PARTNER_BASE_URL = "https://REPLACE_WITH_REVIEW_WORKER_HOST/"
GOOGLE_CLIENT_ID = "REPLACE_WITH_GOOGLE_WEB_CLIENT_ID"

[[ratelimits]]
name = "BURST_LIMITER"
namespace_id = "712001"
[ratelimits.simple]
limit = 120
period = 60

[triggers]
crons = ["15 0 * * *"]

[[d1_databases]]
binding = "DB"
database_name = "poem-submissions"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
